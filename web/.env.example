# --- Deployed Arc Legacy contract addresses (per network) ------------------
VITE_CONTRACT_ADDRESS=          # ArcLegacyV2 estate vault
VITE_YIELD_VAULT=               # ArcYieldVault
VITE_PAYMENT_ROUTER=            # PaymentRouter

# --- Network selection ------------------------------------------------------
# testnet (default) or mainnet. Arc mainnet launches Sep 16 2026; set the
# VITE_ARC_MAINNET_* vars below to Circle's published params, then flip this.
VITE_NETWORK=testnet

# Only needed when VITE_NETWORK=mainnet (fill from Circle at launch):
VITE_ARC_MAINNET_RPC_URL=
VITE_ARC_MAINNET_CHAIN_ID=
VITE_ARC_EXPLORER_URL=          # defaults to https://arcscan.app
VITE_ARC_APPKIT_CHAIN=          # App Kit chain string, defaults to "Arc"
VITE_EURC_ADDRESS=              # EURC token on mainnet
VITE_EARN_VAULT=                # Circle Earn vault on mainnet
VITE_TREASURY_ADDRESS=          # mainnet treasury/operator wallet (use a multisig)

# Optional: override the browser read RPC proxy target.
VITE_RPC_PROXY=
