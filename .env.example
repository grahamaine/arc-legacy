# Deployer wallet private key (0x-prefixed). NEVER commit the real .env.
PRIVATE_KEY=

# Arc testnet RPC (default used if unset)
ARC_RPC_URL=https://rpc.testnet.arc.network

# ---------------------------------------------------------------------------
# Arc MAINNET (public launch Sep 16 2026). Circle has not yet published the
# mainnet RPC URL or chain ID — leave these blank until they do. When set, the
# `arcMainnet` hardhat network activates and you can deploy with:
#   npx hardhat run scripts/deployArcLegacyV2.js --network arcMainnet
# Use a dedicated, deliberately-funded deployer key for mainnet.
# ---------------------------------------------------------------------------
ARC_MAINNET_RPC_URL=
ARC_MAINNET_CHAIN_ID=
MAINNET_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Autonomous agent keeper (agent/keeper.js)
# ---------------------------------------------------------------------------
# The agent's OWN wallet — this is the wallet the autonomous keeper holds and
# transacts from, with no human in the loop. Fund it with a little testnet USDC
# (https://faucet.circle.com). If unset, the keeper falls back to PRIVATE_KEY.
AGENT_PRIVATE_KEY=

# Read-only address for `--dry-run` when no key is set (inspect decisions only).
AGENT_ADDRESS=

# Deployed contracts the keeper drives (defaults baked into keeper.js).
ARC_LEGACY_ADDRESS=0x2b56a883c95B8809BE663E01F18af08b37AbC277
YIELD_VAULT_ADDRESS=0xb5b5CE9C1bD85A68B4fE2F0274d419bE1a3f8761

# Network the keeper targets. Defaults are Arc testnet; set these to point the
# same keeper at Arc mainnet once Circle publishes its params (Sep 16 2026).
KEEPER_CHAIN_ID=5042002
KEEPER_EXPLORER=https://testnet.arcscan.app

# Production circuit-breaker: exit after this many consecutive cycles where
# every action failed (RPC down, wallet drained), so a supervisor can restart.
# 0 disables it (loop forever).
KEEPER_MAX_FAILED_CYCLES=10

# Keeper cadence & thresholds (all optional; sensible defaults in keeper.js).
KEEPER_INTERVAL_SECONDS=60       # seconds between cycles in loop mode
KEEPER_YIELD_FLOOR=0.5           # USDC kept in the wallet as a gas buffer
KEEPER_MIN_SWEEP=0.1             # don't sweep amounts smaller than this
KEEPER_SWEEP_AMOUNT=             # cap each sweep to a fixed amount (e.g. 1) for repeatable demo runs; unset = sweep all above floor
KEEPER_MIN_CLAIM=0.0005          # don't claim interest smaller than this
KEEPER_CHECKIN_LEAD_SECONDS=3600 # check in when < this long remains on the switch
KEEPER_FORCE_CHECKIN=            # set to 1 to check in every cycle (lively demo)
